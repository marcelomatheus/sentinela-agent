# Gere valores diferentes e fortes. Nunca publique o .env.
POSTGRES_USER=sentinela
POSTGRES_PASSWORD=
POSTGRES_DB=sentinela
WEBHOOK_API_KEY=
EVOLUTION_API_URL=https://evolution.example.invalid
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sentinela
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Opcional: Google Safe Browsing v4 (uso acadêmico/não comercial).
SAFE_BROWSING_API_KEY=
HTTP_PORT=8080
# URL de webhook que a Evolution acessa. Para rede Docker compartilhada:
WEBHOOK_URL=http://sentinela-api:8080/webhooks/evolution
# Para uma Evolution hospedada externamente, use HTTPS público em WEBHOOK_URL.
# PUBLIC_WEBHOOK_URL ainda é aceito pelo script como fallback (legado).

# Guardrails (daily quotas reset at UTC midnight)
GUARD_MAX_CHARS=4000
GUARD_MAX_QUESTIONS=3
GUARD_USER_DAILY=20
GUARD_GLOBAL_DAILY=200
GUARD_MAX_OUTPUT_TOKENS=768
GUARD_TIMEOUT_SECONDS=25
GUARD_AUDIO_MAX_BYTES=500000

# Pequeno atraso antes da confirmação Sentinela/Encerrar (0 a 5 segundos).
GATE_REPLY_DELAY_SECONDS=1.5

# Modo de treino opcional: JID EXATO da conversa consigo mesmo (não use em grupos).
# Apenas textos iniciados por /treino e mídias da própria conversa são aceitos.
# Exemplo: SELF_TEST_JID=5511999999999@s.whatsapp.net
SELF_TEST_JID=

# Web channel (optional). Provide only when deploying the BFF:
WEB_INTERNAL_KEY=
WEB_MEDIA_DIR=/data/web
# BFF: OIDC issuer/client and redirect URL; never expose these in Vite.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
BFF_PUBLIC_URL=https://sentinela.example.com
BFF_SESSION_KEY=
BFF_PORT=3005
# Only for local development behind a trusted reverse proxy:
BFF_ALLOW_HTTP=false
